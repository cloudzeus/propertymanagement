generator client {
  provider = "prisma-client"
  output   = "../lib/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  PROPERTY_ADMIN
  PROPERTY_OWNER
  PROPERTY_RESIDENT
  PROPERTY_VIEWER
  COLLABORATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELLED
  EXPIRED
}

enum UnitType {
  APARTMENT
  SHOP
  PARKING
  OTHER
}

// Customer (πελάτης) — individual or company that is billed for our services
enum CustomerType {
  INDIVIDUAL
  COMPANY
}

// How a catalog Service is priced (all charges are monthly)
enum ServicePricingModel {
  PER_UNIT         // × number of units (apartments+shops) — used by CORE
  PER_BUILDING     // × number of buildings
  PER_COMMON_AREA  // × number of common areas
  FLAT             // fixed monthly amount
  METERED_PREPAID  // usage-based with prepaid balance (assemblies: minutes × participants)
}

// Status of a monthly service invoice to a Customer
enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseUtilityType {
  NONE
  POWER
  WATER
  GAS
}

enum ExpenseStatus {
  DRAFT
  CONFIRMED
  ISSUED
}

enum ExpensePaymentMethod {
  CARD
  CASH
  VIVA
  BANK_TRANSFER
  CHECK
  OTHER
}

enum MeterType {
  POWER
  WATER
  GAS
}

// Users table - all users in the system
model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  phone               String?
  mobile              String?
  passwordHash        String?
  role                UserRole
  status              UserStatus @default(ACTIVE)

  roleId              String?
  assignedRole        Role?    @relation("userRole", fields: [roleId], references: [id], onDelete: SetNull)
  createdRoles        Role[]   @relation("roleCreatedBy")

  // Company occupant (owner/resident that is a legal entity, not an individual).
  // Fields kept TRDR-compatible for future SoftOne sync (see Customer).
  isCompany           Boolean  @default(false)
  afm                 String?  // ΑΦΜ — TRDR.AFM
  doy                 String?  // ΔΟΥ — TRDR.IRSDATA
  contactName         String?  // Πρόσωπο επικοινωνίας
  contactEmail        String?  // Email επικοινωνίας (distinct from login email)
  contactPhone        String?  // Τηλέφωνο επικοινωνίας
  softoneTrdr         Int?     // TRDR link for future ERP sync

  // Company association (null for SUPER_ADMIN)
  companyId           String?
  company             Company? @relation("users", fields: [companyId], references: [id], onDelete: SetNull)

  // Customer association (for the customer's manager/staff users)
  customerId          String?
  customer            Customer? @relation("customerUsers", fields: [customerId], references: [id], onDelete: SetNull)

  // Building association (for building-specific roles, e.g. building manager)
  buildingId          String?
  building            Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  // Unit association (for residents/owners)
  ownedUnits          Unit[] @relation("owner")
  residentUnits       Unit[] @relation("resident")
  occupancies         UnitOccupancy[] @relation("userOccupancies")
  infraKeyOf          InfraPoint[] @relation("infraKeyHolder")
  supportTickets      SupportTicket[] @relation("supportTickets")
  infraAccess         InfraAccess[] @relation("infraAccess")

  // Relationships for multi-role users
  companyRoles        UserCompanyRole[]

  // Companies created by this user (for SUPER_ADMIN)
  createdCompanies    Company[] @relation("createdCompanies")

  // Announcements created by this user
  createdAnnouncements Announcement[] @relation("announcementCreatedBy")
  announcementAcks     Announcement_User[] @relation("announcementAcks")

  // Employee records linked to this user
  employeeLinks       Employee[] @relation("employeeUser")

  // Maintenance requests reported by this user
  reportedMaintenance MaintenanceRequest[] @relation("maintenanceReportedBy")

  // Maintenance requests assigned to this user
  assignedMaintenance MaintenanceRequest[] @relation("maintenanceAssignedTo")
  performedMaintenance MaintenanceLog[] @relation("maintenancePerformedBy")
  maintenanceStatusEvents MaintenanceStatusEvent[] @relation("maintenanceStatusBy")
  maintenanceComments     MaintenanceComment[]     @relation("maintenanceComments")
  maintenanceSlots        MaintenanceSlot[]        @relation("maintenanceSlots")
  maintenanceAppointments MaintenanceAppointment[] @relation("maintenanceAppointments")
  notifications           Notification[]           @relation("userNotifications")
  accountCustomers        Customer[]               @relation("customerAccountManager")

  // Collaborator association: COLLABORATOR users belong to a Supplier (the
  // supplier's admin manages the team/catalog from /marketplace).
  supplierId          String?
  supplier            Supplier? @relation("supplierUsers", fields: [supplierId], references: [id], onDelete: SetNull)
  isSupplierAdmin     Boolean  @default(false)

  // API usage logs triggered by this user
  apiUsageLogs        APIUsageLog[]

  // Per-scope management assignments (διαχειριστής of a property/building)
  managementAssignments ManagementAssignment[] @relation("userManagements")

  // Audit fields
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastLoginAt         DateTime?

  // Auth.js session support
  accounts            Account[]
  sessions            Session[]

  @@index([email])
  @@index([companyId])
  @@index([customerId])
  @@index([buildingId])
  @@index([supplierId])
}

// Auth.js Account model
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Auth.js Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Verification token for password reset, email verification
model VerificationToken {
  id          String   @id @default(cuid())
  email       String
  token       String   @unique
  expires     DateTime
  type        String   // 'password-reset' or 'email-verification'

  @@index([email])
  @@index([token])
}

// Companies (Tenants) - SaaS customers
model Company {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  logoUrl               String?

  // Subscription details
  subscriptionTier      SubscriptionTier @default(STARTER)

  // Limits
  maxProperties         Int      @default(1)
  maxUsers              Int      @default(5)
  maxStorage            Int      @default(10)

  // Status
  status                CompanyStatus @default(TRIAL)
  trialEndsAt           DateTime?

  // ── Business profile (SoftOne COMPANY aligned) ───────────────────────────
  // Identity
  afm                   String?   // ΑΦΜ
  taxOffice             String?   // ΔΟΥ
  legalName             String?   // Εναλλακτική επωνυμία (NAME2)
  legalForm             String?   // Νομική μορφή (ΑΕ, ΙΚΕ, ΕΠΕ…)
  activity              String?   // Αντικείμενο δραστηριότητας
  title                 String?   // Τίτλος (SOTITLE)

  // Address
  address               String?
  district              String?   // Νομός/Περιοχή
  city                  String?
  postalCode            String?
  country               String?   @default("Ελλάδα")
  lat                   Float?
  lng                   Float?

  // Contact
  phone1                String?
  phone2                String?
  phone3                String?
  fax                   String?
  email                 String?
  website               String?

  // Identity extras
  glnCode               String?   // GLNCODE — GLN
  registryNumber        String?   // NUMBERM — Αριθ. μητρώου
  vatStatus             String?   // VATSTS  — Καθεστώς ΦΠΑ (Κανονικό/Απαλλαγμένο…)
  distStats             String?   // DISTSTATS — Υ.Σ.Ν.

  // Registration
  gemhNumber            String?   // NUMCG   — ΓΕΜΗ
  ikaNumber             String?   // IKA     — Ε.Φ.Κ.Α. υποκατάστημα
  ikaRegistry           String?   // IKAM    — Μητρώο Ε.Φ.Κ.Α.
  folderNumber          String?   // FOLDERNUM — Αρ. φακέλου
  kadCode               String?   // KAD     — ΚΑΔ

  // Dates
  foundedAt             DateTime? // CRTDATE — Ίδρυση
  dissolutionDate       DateTime? // FNLDATE — Λύση

  // Financial
  iban                  String?
  bank                  String?
  initialCapital        Float?    // INITCAPITAL
  paidCapital           Float?    // PAIDCAPITAL

  // Legal representative
  legalRep              String?   // CFONAME     — Πρόεδρος Δ.Σ.
  legalRepId            String?   // IDENTITYNUM — Α.Δ.Τ.

  // HR / Social security
  tpte                  String?   // TPTE        — Τ.Π.Τ.Ε e-Ε.Φ.Κ.Α.
  tpteteka              String?   // TPTETEKA    — Τ.Π.Τ.Ε Τ.Ε.Κ.Α
  employmentOrg         String?   // ERGORGANOSI — Εργοδοτική οργάνωση

  // Misc
  remarks               String?   @db.Text // REMARKS — Παρατηρήσεις

  // SoftOne integration
  softoneCompanyCode    Int?      // COMPANY.COMPANY code in SoftOne ERP
  // ─────────────────────────────────────────────────────────────────────────

  // Relations
  createdById           String?
  createdBy             User?    @relation("createdCompanies", fields: [createdById], references: [id], onDelete: SetNull)

  users                 User[] @relation("users")
  customers             Customer[]
  properties            Property[]
  buildings             Building[]
  services              Service[]
  subscription          Subscription?
  addonFeatures         AddonFeature[]
  userRoles             UserCompanyRole[]
  apiUsageLogs          APIUsageLog[]
  costSummaries         MonthlyCostSummary[]
  departments           Department[]
  jobPositions          JobPosition[]
  employees             Employee[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

// Departments (Τμήματα εταιρείας)
model Department {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  description   String?     @db.Text
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)

  positions     JobPosition[]
  employees     Employee[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([companyId])
}

// Job Positions (Θέσεις εργασίας)
model JobPosition {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title         String
  description   String?     @db.Text
  level         String?     // Junior, Senior, Manager, Director, Executive
  isActive      Boolean     @default(true)

  employees     Employee[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([companyId])
  @@index([departmentId])
}

// Employees (Υπάλληλοι)
model Employee {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobPositionId   String?
  jobPosition     JobPosition?   @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)

  // Linked application user account (optional)
  userId          String?
  user            User?          @relation("employeeUser", fields: [userId], references: [id], onDelete: SetNull)

  // Personal
  firstName       String
  lastName        String
  email           String?
  phone           String?
  mobile          String?

  // Employment
  employeeCode    String?
  hireDate        DateTime?
  terminationDate DateTime?
  status          EmployeeStatus @default(ACTIVE)

  // Tax / Social security
  afm             String?
  amka            String?
  ikaNumber       String?

  // Address
  address         String?
  city            String?
  postalCode      String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId])
  @@index([departmentId])
  @@index([jobPositionId])
  @@index([userId])
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

// Subscriptions - billing records
model Subscription {
  id                    String   @id @default(cuid())

  // Company link
  companyId             String   @unique
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Billing details
  vivaBatchId           String?  // Viva Payments reference
  tier                  SubscriptionTier
  billingCycle          BillingCycle
  amount                Float    // EUR
  currency              String   @default("EUR")
  status                SubscriptionStatus @default(ACTIVE)

  // Dates
  startDate             DateTime
  endDate               DateTime
  renewalDate           DateTime

  // Trial info
  trialDays             Int?
  trialUsed             Int      @default(0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

// Add-on Features - premium features purchased per property
model AddonFeature {
  id                    String   @id @default(cuid())

  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  buildingId            String?
  building              Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  // Feature type
  featureKey            String   // 'analytics', 'api', 'sms', 'whitelabel'
  featureName           String
  description           String?

  // Billing
  monthlyPrice          Float
  billingCycle          BillingCycle @default(MONTHLY)
  active                Boolean  @default(true)

  activatedAt           DateTime @default(now())
  expiresAt             DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, buildingId, featureKey])
  @@index([companyId])
  @@index([buildingId])
}

// Customer (πελάτης) — individual or company billed for our services.
// Owns one or more Properties; is the target of service invoicing.
model Customer {
  id                    String   @id @default(cuid())

  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type                  CustomerType @default(INDIVIDUAL)

  // ── SoftOne TRDR alignment (future ERP sync) ─────────────────────────────
  // SODTYPE distinguishes trading-partner kind in SoftOne's shared TRDR table:
  //   13 = Πελάτης (Customer)  ·  12 = Προμηθευτής (Supplier)
  sodType               Int      @default(13) // SODTYPE — 13 customer / 12 supplier
  softoneTrdr           Int?     // TRDR (AutoInc PK in SoftOne) — link for sync
  code                  String?  // CODE — Κωδικός συναλλασσόμενου
  // ─────────────────────────────────────────────────────────────────────────

  // Identity / billing (TRDR-aligned)
  name                  String   // NAME — Επωνυμία (company) / full name (individual)
  afm                   String?  // AFM — ΑΦΜ
  doy                   String?  // IRSDATA — ΔΟΥ
  email                 String?  // EMAIL
  phone                 String?  // PHONE01 — Τηλ.1
  phone2                String?  // PHONE02 — Τηλ.2
  fax                   String?  // FAX
  webpage               String?  // WEBPAGE
  address               String?  // ADDRESS — Διεύθυνση
  city                  String?  // CITY — Πόλη
  district              String?  // DISTRICT — Περιοχή
  postalCode            String?  // ZIP — Τ.Κ.
  country               String?  // COUNTRY (SoftOne uses Smallint code; stored as text here)
  isActive              Boolean  @default(true) // ISACTIVE
  remarks               String?  // REMARKS — Παρατηρήσεις

  // Geodata (geocoded from the address)
  lat                   Float?
  lng                   Float?

  // Υπεύθυνος manager (στέλεχος εταιρίας) για τον πελάτη και τα ακίνητά του.
  accountManagerId      String?
  accountManager        User?    @relation("customerAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)

  // Relations
  users                 User[]   @relation("customerUsers")
  properties            Property[]
  buildings             Building[] @relation("customerBuildings")
  units                 Unit[]     @relation("customerUnits")
  invoices              ServiceInvoice[]
  announcements         Announcement[] @relation("customerAnnouncements")
  meteredPlan           CustomerMeteredPlan?
  suppliers             Supplier[] @relation("customerSuppliers") // the customer's PRIVATE supplier list
  workOrders            WorkOrder[]
  supplierInquiries     SupplierInquiry[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, softoneTrdr])
  @@index([companyId])
  @@index([sodType])
  @@index([afm])
}

// Property (Ιδιοκτησία) — a customer's holding; can contain MANY buildings.
// The service package and billing live at this level.
model Property {
  id                    String   @id @default(cuid())

  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId            String
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name                  String
  notes                 String?

  // Whether the managing company runs this property. When true, the property's
  // manager (διαχειριστής) must be a company employee; when false (self-managed),
  // owners/residents/the customer may be assigned as manager.
  managed               Boolean  @default(true)

  // Address & geodata
  address               String?
  city                  String?
  postalCode            String?
  country               String?  @default("Ελλάδα")
  lat                   Float?
  lng                   Float?

  // Optional OWN Viva account — κοινόχρηστα are managed INDEPENDENTLY per property,
  // so residents' κοινόχρηστα payments go to this property's own Viva account.
  vivaEnabled           Boolean  @default(false)
  vivaMerchantId        String?
  vivaApiKeyEnc         String?  // stored encrypted
  vivaSourceCode        String?

  // Relations
  buildings             Building[]
  services              PropertyService[]
  managementAssignments ManagementAssignment[]
  maintenanceCoverageRules MaintenanceCoverageRule[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@index([name])
}

enum MillesimeSource {
  AUTO
  MANUAL
}

enum DistributionBasis {
  GENERAL_MILLESIMES
  ELEVATOR_MILLESIMES
  HEATING_MILLESIMES
  EQUAL_PER_UNIT
  METERED_70_30
}

// Building (Κτήριο) — a physical building under a Property.
model Building {
  id                    String   @id @default(cuid())

  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  propertyId            String
  property              Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Denormalized owning customer (= property.customerId) for per-customer data isolation.
  customerId            String
  customer              Customer @relation("customerBuildings", fields: [customerId], references: [id], onDelete: Cascade)

  // Basic info
  name                  String
  address               String
  city                  String
  postalCode            String
  country               String   @default("Greece")
  imageUrl              String?  // BunnyCDN URL

  // Details
  floors                Int?     // above-ground όροφοι (excludes ισόγειο)
  basements             Int?     // υπόγεια (number of basement levels)
  unitsCount            Int      @default(0)

  // Technical
  hasElevator           Boolean  @default(false)
  hasBoiler             Boolean  @default(false)
  hasFireSafety         Boolean  @default(false)
  technicalNotes        String?

  // Elevator floor parameters (κοινόχρηστα ασανσέρ)
  elevatorSurchargePerFloor  Float   @default(0.10)
  elevatorExemptGroundFloor  Boolean @default(true)
  heatingMeterUnit           String?

  // Geodata
  lat                   Float?
  lng                   Float?

  // Relations
  users                 User[]
  units                 Unit[]
  commonAreas           CommonArea[]
  managedItems          ManagedItem[]
  addons                AddonFeature[]
  announcements         Announcement[]
  dailyRoomName         String?
  assemblies            Assembly[]
  maintenanceRequests   MaintenanceRequest[]
  managementAssignments ManagementAssignment[]
  files                 BuildingFile[]
  infraPoints           InfraPoint[]
  contacts              Contact[]
  recurringTasks        RecurringTask[]
  maintenanceLogs       MaintenanceLog[]
  expenses              BuildingExpense[]
  categoryOverrides     BuildingCategoryOverride[]
  meterReadings         MeterReading[]
  heatingReadings       UnitHeatingReading[]
  preferredSuppliers    BuildingPreferredSupplier[]
  serviceRequests       ServiceRequest[]
  workOrders            WorkOrder[]
  supplierInquiries     SupplierInquiry[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId])
  @@index([propertyId])
  @@index([customerId])
  @@index([name])
}

// ── Building control-center sub-entities ─────────────────────────────────────

enum OccupancyRole {
  OWNER
  RESIDENT
}

// Occupancy timeline per unit — residents/owners change over time (από/έως).
// The "current" occupant of a role is the row with endDate = null.
model UnitOccupancy {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("userOccupancies", fields: [userId], references: [id], onDelete: Cascade)
  role        OccupancyRole
  startDate   DateTime @default(now())
  endDate     DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  @@index([unitId])
  @@index([userId])
  @@index([unitId, role, endDate])
}

enum BuildingFileCategory {
  PLANS
  PHOTOS
  DOCUMENTS
  CERTIFICATES
  RECEIPT
  PAYMENT
  MAINTENANCE
  OTHER
}

model BuildingFile {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  category    BuildingFileCategory @default(OTHER)
  name        String
  cdnPath     String   // storage path inside the building folder
  url         String   // public CDN url
  mimeType    String?
  sizeBytes   Int?
  uploadedById String?
  createdAt   DateTime @default(now())
  expenseLinks BuildingExpense[] @relation("expenseReceipt")
  paymentLinks BuildingExpense[] @relation("expensePayment")
  maintenanceLogs MaintenanceLog[] @relation("maintenanceDocument")
  @@index([buildingId])
  @@index([buildingId, category])
}

enum InfraType {
  ELECTRICITY
  OTE
  ROOF
  ANTENNA
  BOILER
  PUMP
  FIRE
  WATER
  OTHER
}

model InfraPoint {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name        String
  type        InfraType @default(OTHER)
  floorLabel  String?
  location    String?
  locked      Boolean  @default(false)
  accessNotes String?  // legacy free-text (superseded by access[])
  keyHolder   String?  // legacy free-text (superseded by keyHolderUser)
  photoUrl    String?  // legacy cover (superseded by media[])
  notes       String?

  // Key holder = a specific user (owner/resident/manager/employee)
  keyHolderUserId String?
  keyHolderUser   User?    @relation("infraKeyHolder", fields: [keyHolderUserId], references: [id], onDelete: SetNull)

  // Who has access (many users) + media (many photos/videos)
  access      InfraAccess[]
  media       InfraMedia[]
  meterReadings MeterReading[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([buildingId])
}

model InfraAccess {
  id           String     @id @default(cuid())
  infraPointId String
  infraPoint   InfraPoint @relation(fields: [infraPointId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("infraAccess", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([infraPointId, userId])
  @@index([infraPointId])
}

enum InfraMediaType {
  IMAGE
  VIDEO
}

model InfraMedia {
  id           String     @id @default(cuid())
  infraPointId String
  infraPoint   InfraPoint @relation(fields: [infraPointId], references: [id], onDelete: Cascade)
  type         InfraMediaType @default(IMAGE)
  url          String
  cdnPath      String
  name         String?
  createdAt    DateTime   @default(now())
  @@index([infraPointId])
}

model Contact {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  phone       String?
  email       String?
  notes       String?
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  @@index([buildingId])
  @@index([supplierId])
}

enum TaskFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum MaintenanceKind {
  GENERAL
  ELEVATOR
  BOILER
  FIRE_SAFETY
  HVAC
  ELECTRICAL
  PLUMBING
  OTHER
}

model RecurringTask {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title       String
  frequency   TaskFrequency @default(MONTHLY)
  nextDueDate DateTime?
  lastDoneDate DateTime?
  vendor      String?
  notes       String?
  active      Boolean  @default(true)
  kind               MaintenanceKind @default(GENERAL)
  inServicePackage   Boolean  @default(false)
  reminderDaysBefore Int      @default(7)
  reminderSentAt     DateTime?
  logs               MaintenanceLog[]
  managedItemId      String?
  managedItem        ManagedItem? @relation(fields: [managedItemId], references: [id], onDelete: SetNull)
  // Ανάδοχος from a registry; `vendor` stays as the free-text fallback/label.
  supplierId         String?
  supplier           Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // Faults opened from an occurrence of this schedule (annual programme).
  requests           MaintenanceRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([buildingId])
  @@index([managedItemId])
  @@index([supplierId])
}

model MaintenanceLog {
  id               String        @id @default(cuid())
  recurringTaskId  String
  recurringTask    RecurringTask @relation(fields: [recurringTaskId], references: [id], onDelete: Cascade)
  buildingId       String
  building         Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  performedAt      DateTime
  performedById    String?
  performedBy      User?         @relation("maintenancePerformedBy", fields: [performedById], references: [id], onDelete: SetNull)
  cost             Decimal?      @db.Decimal(10, 2)
  notes            String?
  documentFileId   String?
  documentFile     BuildingFile? @relation("maintenanceDocument", fields: [documentFileId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())

  @@index([recurringTaskId])
  @@index([buildingId])
}

model BuildingExpense {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  month       String   // YYYY-MM
  category    String?
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  receiptFileId String?
  receiptFile BuildingFile? @relation("expenseReceipt", fields: [receiptFileId], references: [id], onDelete: SetNull)
  categoryId     String?
  categoryRef    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierName   String?
  supplierVat    String?
  // Linked registry supplier (auto-matched by ΑΦΜ on OCR, or picked manually).
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  documentNumber String?
  documentDate   DateTime?
  netAmount      Decimal? @db.Decimal(10, 2)
  vatAmount      Decimal? @db.Decimal(10, 2)
  status         ExpenseStatus @default(CONFIRMED)
  tenantPct      Int      @default(0)
  ownerPct       Int      @default(100)
  ocrRaw         Json?
  ocrConfidence  Float?
  issuedMonth    String?  // YYYY-MM of the κοινόχρηστα issuance this expense was locked into
  paid           Boolean  @default(false)
  paymentMethod  ExpensePaymentMethod?
  paidAt         DateTime?
  paymentFileId  String?
  paymentFile    BuildingFile? @relation("expensePayment", fields: [paymentFileId], references: [id], onDelete: SetNull)
  meterReadings  MeterReading[]
  allocations    ExpenseAllocation[]
  createdAt   DateTime @default(now())
  @@index([buildingId])
  @@index([buildingId, month])
  @@index([categoryId])
  @@index([supplierId])
}

model ExpenseCategory {
  id        String  @id @default(cuid())
  name      String
  code      String  @unique
  utilityType ExpenseUtilityType @default(NONE)
  defaultBasis DistributionBasis @default(GENERAL_MILLESIMES)
  defaultTenantPct Int @default(0)
  defaultOwnerPct  Int @default(100)
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  expenses  BuildingExpense[]
  overrides BuildingCategoryOverride[]
  exclusions UnitCategoryExclusion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BuildingCategoryOverride {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tenantPct  Int
  ownerPct   Int
  distributionBasis DistributionBasis?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([buildingId, categoryId])
  @@index([buildingId])
}

model UnitCategoryExclusion {
  id         String   @id @default(cuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([unitId, categoryId])
  @@index([unitId])
  @@index([categoryId])
}

model UnitHeatingReading {
  id              String   @id @default(cuid())
  buildingId      String
  building        Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  period          String   // YYYY-MM
  previousReading Decimal? @db.Decimal(12, 3)
  currentReading  Decimal? @db.Decimal(12, 3)
  consumption     Decimal? @db.Decimal(12, 3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([unitId, period])
  @@index([buildingId, period])
}

model MeterReading {
  id             String   @id @default(cuid())
  buildingId     String
  building       Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  infraPointId   String?
  infraPoint     InfraPoint? @relation(fields: [infraPointId], references: [id], onDelete: SetNull)
  expenseId      String?
  expense        BuildingExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  meterType      MeterType
  meterNumber    String?
  periodFrom     DateTime?
  periodTo       DateTime?
  previousReading Decimal? @db.Decimal(12,3)
  currentReading  Decimal? @db.Decimal(12,3)
  consumption     Decimal? @db.Decimal(12,3)
  unit           String?
  createdAt      DateTime @default(now())
  @@index([buildingId])
  @@index([infraPointId])
}

model ExpenseAllocation {
  id           String  @id @default(cuid())
  expenseId    String
  expense      BuildingExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitShare    Decimal @db.Decimal(10,2)
  breakdownNote String?
  tenantUserId String?
  tenantAmount Decimal @db.Decimal(10,2) @default(0)
  tenantPaid   Boolean @default(false)
  tenantPaidAt DateTime?
  tenantPaymentMethod ExpensePaymentMethod?
  ownerUserId  String?
  ownerAmount  Decimal @db.Decimal(10,2) @default(0)
  ownerPaid    Boolean @default(false)
  ownerPaidAt  DateTime?
  ownerPaymentMethod ExpensePaymentMethod?
  createdAt    DateTime @default(now())
  @@index([expenseId])
  @@index([unitId])
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

model UnitPayment {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  month       String   // YYYY-MM
  amount      Decimal  @db.Decimal(10, 2)
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([unitId, month])
  @@index([unitId])
}

// Per-scope manager (διαχειριστής) assignment. Grants PROPERTY_ADMIN-level
// management of ONE property or ONE building. A user may hold many assignments
// (manage multiple scopes) and still be an owner/resident elsewhere.
model ManagementAssignment {
  id          String    @id @default(cuid())

  userId      String
  user        User      @relation("userManagements", fields: [userId], references: [id], onDelete: Cascade)

  // Exactly one of propertyId / buildingId is set (property-level or building-level).
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buildingId  String?
  building    Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  role        UserRole  @default(PROPERTY_ADMIN)

  createdAt   DateTime  @default(now())

  @@unique([userId, propertyId, buildingId])
  @@index([userId])
  @@index([propertyId])
  @@index([buildingId])
}

// Common areas (κοινόχρηστοι χώροι) — drive PER_COMMON_AREA pricing.
model CommonArea {
  id                    String   @id @default(cuid())

  buildingId            String
  building              Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  name                  String
  type                  String?
  floor                 Int?
  notes                 String?

  managedItems          ManagedItem[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([buildingId])
}

// Catalog of managed-item types (Στοιχεία Διαχείρισης) — company-wide master list
// maintained at /super-admin/managed-items, e.g. "Αλλαγή λαμπτήρων". Buildings pick
// from this catalog via ManagedItem.
model ManagedItemType {
  id                    String   @id @default(cuid())

  name                  String   @unique // π.χ. "Αλλαγή λαμπτήρων"
  notes                 String?
  active                Boolean  @default(true) // ανενεργοί τύποι δεν προτείνονται σε νέες αναθέσεις

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  items                 ManagedItem[]
}

// Managed items (διαχειριζόμενα στοιχεία κτηρίου) — assignment of a catalog type to a
// managed building with location, quantity and optional photo. Only meaningful when
// building.property.managed = true.
model ManagedItem {
  id                    String   @id @default(cuid())

  buildingId            String
  building              Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  itemTypeId            String
  itemType              ManagedItemType @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)

  location              String   // τοποθεσία, π.χ. "Κοινόχρηστοι χώροι", "Κλιμακοστάσιο Α"
  floorLabel            String?  // προαιρετικός όροφος, π.χ. "Ισόγειο"
  quantity              Int      @default(1) // πλήθος, π.χ. αριθμός φωτιστικών
  photoUrl              String?  // προαιρετική φωτογραφία (BunnyCDN URL)
  photoCdnPath          String?
  notes                 String?

  commonAreaId          String?
  commonArea            CommonArea? @relation(fields: [commonAreaId], references: [id], onDelete: SetNull)
  tasks                 RecurringTask[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([buildingId])
  @@index([itemTypeId])
  @@index([commonAreaId])
}

// Units - apartments, shops, parking spaces
model Unit {
  id                    String   @id @default(cuid())

  buildingId            String
  building              Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  // Denormalized owning customer (= building.property.customerId) for data isolation.
  customerId            String
  customer              Customer @relation("customerUnits", fields: [customerId], references: [id], onDelete: Cascade)

  // Basic info
  unitNumber            String
  unitType              UnitType @default(APARTMENT)
  floor                 Int?
  areaSqm               Float?   // τετραγωνικά
  millesimes            Float?   // χιλιοστά (for κοινόχρηστα distribution)
  millesimesElevator    Float?
  millesimesHeating     Float?
  millesimesSource          MillesimeSource @default(AUTO)
  millesimesElevatorSource  MillesimeSource @default(AUTO)
  millesimesHeatingSource   MillesimeSource @default(AUTO)
  categoryExclusions    UnitCategoryExclusion[]
  heatingReadings       UnitHeatingReading[]

  // Ownership
  ownerId               String?
  owner                 User?    @relation("owner", fields: [ownerId], references: [id], onDelete: SetNull)

  residentId            String?
  resident              User?    @relation("resident", fields: [residentId], references: [id], onDelete: SetNull)

  // Relations
  maintenanceRequests   MaintenanceRequest[]
  payments              UnitPayment[]
  occupancies           UnitOccupancy[]
  expenseAllocations    ExpenseAllocation[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([buildingId, unitNumber])
  @@index([buildingId])
  @@index([customerId])
  @@index([ownerId])
  @@index([residentId])
}

// Service catalog (provider-defined) — each service has a pricing model.
model Service {
  id                    String   @id @default(cuid())

  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name                  String
  code                  String   @unique
  description           String?
  isCore                Boolean  @default(false)
  pricingModel          ServicePricingModel
  price                 Decimal  @db.Decimal(10, 2) // monthly rate / unit rate
  active                Boolean  @default(true)

  propertyServices      PropertyService[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId])
}

// PropertyService — a service enabled on a Property (the package).
model PropertyService {
  id                    String   @id @default(cuid())

  propertyId            String
  property              Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  serviceId             String
  service               Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  active                Boolean  @default(true)
  startedAt             DateTime?
  endedAt               DateTime?

  // For METERED_PREPAID (assemblies): prepaid balance in person-minutes.
  prepaidPersonMinutes  Int      @default(0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([propertyId, serviceId])
  @@index([propertyId])
  @@index([serviceId])
}

// Monthly service invoice issued by the provider to a Customer.
model ServiceInvoice {
  id                    String   @id @default(cuid())

  customerId            String
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  period                String   // "YYYY-MM"
  amount                Decimal  @db.Decimal(10, 2)
  status                InvoiceStatus @default(PENDING)

  issuedAt              DateTime @default(now())
  dueDate               DateTime?
  paidAt                DateTime?
  vivaOrderRef          String?  // provider Viva transaction reference

  lines                 ServiceInvoiceLine[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([customerId, period])
  @@index([customerId])
  @@index([status])
}

model ServiceInvoiceLine {
  id                    String   @id @default(cuid())

  invoiceId             String
  invoice               ServiceInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description           String
  qty                   Int      @default(1)
  unitPrice             Decimal  @db.Decimal(10, 2)
  amount                Decimal  @db.Decimal(10, 2)

  @@index([invoiceId])
}

// User Company Role - for multi-role support
model UserCompanyRole {
  id                    String   @id @default(cuid())

  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  role                  UserRole
  department            String?  // For MANAGER/EMPLOYEE
  position              String?  // For EMPLOYEE

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

// Announcements - digital signage content
model Announcement {
  id                    String   @id @default(cuid())

  buildingId            String?
  building              Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  customerId            String?
  customer              Customer? @relation("customerAnnouncements", fields: [customerId], references: [id], onDelete: Cascade)

  title                 String
  content               String   @db.Text   // rich text (HTML)
  imageUrl              String?  // BunnyCDN URL

  status                String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  audience              String   @default("ALL") // ALL, OWNERS, RESIDENTS, CUSTOM
  origin                String   @default("STAFF")

  emailSubject          String?
  emailPreview          String?
  senderName            String?
  senderReplyTo         String?

  publishedAt           DateTime?
  expiresAt             DateTime?

  recurringTaskId       String?  // optional linked calendar entry

  createdById           String?
  createdBy             User?    @relation("announcementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  recipients            Announcement_User[]
  targets               AnnouncementTarget[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([buildingId])
  @@index([customerId])
  @@index([status])
}

model AnnouncementTarget {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  scopeType      String       // PROPERTY | BUILDING | UNIT | USER
  scopeId        String

  @@index([announcementId])
  @@index([scopeType, scopeId])
}

model Announcement_User {
  id                    String       @id @default(cuid())
  announcementId        String
  announcement          Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId                String
  user                  User         @relation("announcementAcks", fields: [userId], references: [id], onDelete: Cascade)

  token                 String       @unique @default(cuid())
  sentAt                DateTime?
  readAt                DateTime?
  acknowledgedAt        DateTime?
  ipAddress             String?
  userAgent             String?

  @@unique([announcementId, userId])
  @@index([userId])
}

enum AssemblyStatus {
  SCHEDULED
  LIVE
  ENDED
  TRANSCRIBING
  DRAFT_READY
  APPROVED
  SENT
  CANCELLED
}

model Assembly {
  id              String          @id @default(cuid())
  buildingId      String
  building        Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title           String
  scheduledAt     DateTime
  status          AssemblyStatus  @default(SCHEDULED)
  dailyRoomName   String
  dailySessionId  String?
  transcriptRaw   String?         @db.Text
  minutesDraft    String?         @db.Text
  minutesFinal    String?         @db.Text
  approvedAt      DateTime?
  sentAt          DateTime?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  participants    AssemblyParticipant[]

  @@index([buildingId])
  @@index([status])
}

model AssemblyParticipant {
  id              String    @id @default(cuid())
  assemblyId      String
  assembly        Assembly  @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  userId          String?
  unitId          String?
  email           String?   // for invited guests/test participants without an app account
  isHost          Boolean   @default(false)
  displayName     String
  joinedAt        DateTime?
  leftAt          DateTime?
  durationSeconds Int       @default(0)
  invitedSentAt   DateTime?
  momSentAt       DateTime?

  @@index([assemblyId])
  @@index([userId])
}

// Webhook replay protection — one row per processed delivery (id = sha256 of the signed string)
model ProcessedWebhook {
  id        String   @id
  source    String   @default("daily")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// API Usage Tracking - for cost monitoring
model APIUsageLog {
  id                    String   @id @default(cuid())

  // API details
  apiName               String   // 'mailgun', 'bunnycdn', 'deepseek', 'gemini'
  endpoint              String?  // e.g., '/send-email', '/upload-file', '/translate'
  model                 String?  // e.g., 'deepseek-chat', 'gemini-pro'

  // Usage metrics
  requestCount          Int      @default(1)
  tokensUsed            Int?     // For LLM APIs
  bytesProcessed        Int?     // For storage/bandwidth
  costPerUnit           Float    // Cost per request/token/byte in EUR
  totalCost             Float    // Total cost in EUR
  currency              String   @default("EUR")
  billedCostEur         Float?   // real × (1 + markup#1)
  customerChargeEur     Float?   // billed × (1 + markup#2)
  walletTxnCompanyId    String?  // WalletTransaction.id for the company debit
  walletTxnCustomerId   String?  // WalletTransaction.id for the customer debit

  // Metadata
  companyId             String?  // Which company triggered this (null = system)
  company               Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  userId                String?  // Which user triggered this
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  buildingId            String?
  customerId            String?
  assemblyId            String?

  status                String   @default("SUCCESS") // SUCCESS, FAILED, RETRY
  errorMessage          String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([apiName])
  @@index([companyId])
  @@index([userId])
  @@index([createdAt])
  @@index([buildingId])
  @@index([customerId])
  @@index([assemblyId])
}

// API Cost Settings - configurable by SUPER_ADMIN
model APICostConfig {
  id                    String   @id @default(cuid())

  // API pricing
  apiName               String   @unique
  displayName           String   // "Mailgun", "BunnyCDN", "Deepseek", "Gemini"

  // Pricing structure
  costModel             String   // 'per_request', 'per_token', 'per_gb', 'per_email'
  basePrice             Float    // Cost per unit in EUR
  freeQuota             Int      @default(0) // Free units per month
  quotaResetDay         Int      @default(1) // Day of month to reset quota

  // Markup
  markupPercent         Float    @default(0) // % added on top of real cost for admin-facing billing

  // Limits
  monthlyBudgetLimit    Float?   // Optional budget cap in EUR
  enabled               Boolean  @default(true)

  // Metadata
  notes                 String?  @db.Text
  documentationUrl      String?
  category              String   @default("api") // 'ai' | 'api' | 'video'
  unitLabel             String   @default("units") // e.g. "tokens", "λεπτά", "emails"

  updatedAt             DateTime @updatedAt
  updatedBy             String?  // SUPER_ADMIN user ID

  @@index([apiName])
}

enum WalletOwnerType {
  COMPANY
  CUSTOMER
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
}

enum WalletTxnType {
  ALLOWANCE
  TOPUP
  DEBIT
  ADJUSTMENT
  RESET
}

model Wallet {
  id            String              @id @default(cuid())
  ownerType     WalletOwnerType
  ownerId       String
  balanceEur    Decimal             @default(0) @db.Decimal(12, 4)
  lowBalanceEur Decimal?            @db.Decimal(12, 4)
  status        WalletStatus        @default(ACTIVE)
  transactions  WalletTransaction[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([ownerType, ownerId])
  @@index([ownerType])
}

model WalletTransaction {
  id           String        @id @default(cuid())
  walletId     String
  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         WalletTxnType
  amountEur    Decimal       @db.Decimal(12, 4)
  balanceAfter Decimal       @db.Decimal(12, 4)
  description  String
  refType      String?
  refId        String?
  createdById  String?
  createdAt    DateTime      @default(now())

  @@index([walletId])
  @@index([refType, refId])
  @@index([createdAt])
}

model CustomerMeteredPlan {
  id                  String   @id @default(cuid())
  customerId          String   @unique
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  monthlyAllowanceEur Decimal  @default(0) @db.Decimal(10, 2)
  rollover            Boolean  @default(false)
  adminMarkupPercent  Float    @default(0)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Monthly Cost Summary - pre-calculated for faster reporting
model MonthlyCostSummary {
  id                    String   @id @default(cuid())

  year                  Int
  month                 Int
  apiName               String

  requestCount          Int      @default(0)
  tokensUsed            Int      @default(0)
  bytesProcessed        Int      @default(0)
  totalCost             Float    @default(0)

  companyId             String?
  company               Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt             DateTime @default(now())

  @@unique([year, month, apiName, companyId])
  @@index([companyId])
}

// Maintenance Requests - core feature
model MaintenanceRequest {
  id                    String   @id @default(cuid())

  buildingId            String
  building              Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  unitId                String?
  unit                  Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  title                 String
  description           String   @db.Text

  category              String   // legacy free-text ('plumbing', 'electrical', ...); new rows also set categoryId
  categoryId            String?
  categoryRef           MaintenanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  priority              String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status                String   @default("OPEN") // OPEN, ACKNOWLEDGED, SCHEDULED, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED

  // Who is responsible for resolution: COMPANY (managed contract covers it) or PROPERTY_ADMIN
  handledBy             String   @default("PROPERTY_ADMIN")

  // SLA tracking
  slaDueAt              DateTime?
  firstResponseAt       DateTime?

  // Restricted-access equipment flow (appointment booking)
  restrictedAccess      Boolean  @default(false)
  managerPresence       Boolean  @default(false) // ο διαχειριστής πρέπει να είναι παρών
  estimatedMinutes      Int?     // εκτίμηση διάρκειας αποκατάστασης από την εταιρία

  reportedById          String?
  reportedBy            User?    @relation("maintenanceReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)

  assignedToId          String?
  assignedTo            User?    @relation("maintenanceAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // External supplier the company (Orithon) assigned the job to. Only company
  // staff may set this — never the property manager (see suppliers program).
  supplierId            String?
  supplier              Supplier? @relation("maintenanceSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  // Set when the fault was opened from a recurring-task occurrence.
  recurringTaskId       String?
  recurringTask         RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)
  inquiries             SupplierInquiry[]
  supplierRating        SupplierRating?
  serviceRequests       ServiceRequest[]
  workOrders            WorkOrder[]

  attachmentUrl         String?  // BunnyCDN URL

  scheduledDate         DateTime?
  completedAt           DateTime?
  notes                 String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  attachments           MaintenanceAttachment[]
  statusEvents          MaintenanceStatusEvent[]
  comments              MaintenanceComment[]
  slots                 MaintenanceSlot[]
  appointments          MaintenanceAppointment[]
  notifications         Notification[]

  @@index([buildingId])
  @@index([unitId])
  @@index([status])
  @@index([priority])
  @@index([categoryId])
  @@index([handledBy])
  @@index([slaDueAt])
  @@index([supplierId])
}

// Κατηγορίες βλαβών (διαχειρίσιμες από την εταιρία)
model MaintenanceCategory {
  id                 String  @id @default(cuid())
  name               String
  icon               String?  // react-icons/ri name
  active             Boolean @default(true)
  sortOrder          Int     @default(0)
  slaHours           Int?    // προεπιλεγμένο SLA επίλυσης σε ώρες
  companyResponsible Boolean @default(false) // default: καλύπτεται από managed συμβόλαιο

  requests      MaintenanceRequest[]
  coverageRules MaintenanceCoverageRule[]
  suppliers     SupplierCategory[] // suppliers declaring this as a specialty
  preferredBy   BuildingPreferredSupplier[]
  catalogItems  ServiceCatalogItem[]
  serviceRequests ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Τι καλύπτει το managed συμβόλαιο — global default (propertyId null) ή ανά ακίνητο.
// Κάλυψη κατά κατηγορία ή/και ποσοτικά (quantityLimit ανά periodMonths).
model MaintenanceCoverageRule {
  id           String  @id @default(cuid())
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     MaintenanceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  elementLabel String?  // ελεύθερη περιγραφή στοιχείου, π.χ. "Κοινόχρηστα φώτα"
  covered      Boolean @default(true)
  quantityLimit Int?   // μέγιστες επιλύσεις στην περίοδο (null = απεριόριστες)
  periodMonths  Int?   // περίοδος μέτρησης του ορίου (null = 12)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([categoryId])
}

model MaintenanceAttachment {
  id          String @id @default(cuid())
  requestId   String
  request     MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  url         String  // BunnyCDN URL
  cdnPath     String?
  kind        String  @default("IMAGE") // IMAGE, VIDEO
  contentType String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())

  @@index([requestId])
}

model MaintenanceStatusEvent {
  id         String @id @default(cuid())
  requestId  String
  request    MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  note       String? @db.Text
  byUserId   String?
  byUser     User?   @relation("maintenanceStatusBy", fields: [byUserId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([requestId])
}

// Επικοινωνία δύο μεριών πάνω στη βλάβη
model MaintenanceComment {
  id        String @id @default(cuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?  @relation("maintenanceComments", fields: [authorId], references: [id], onDelete: SetNull)
  body      String @db.Text
  internal  Boolean @default(false) // ορατό μόνο σε προσωπικό εταιρίας
  createdAt DateTime @default(now())

  @@index([requestId])
}

// Διαθέσιμα slots 30' που δηλώνει κάθε πλευρά για κλείσιμο ραντεβού
model MaintenanceSlot {
  id          String @id @default(cuid())
  requestId   String
  request     MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  side        String  // COMPANY, MANAGER
  startAt     DateTime // πάντα σε όρια 30 λεπτών
  status      String  @default("OPEN") // OPEN, SELECTED, CANCELLED
  offeredById String?
  offeredBy   User?   @relation("maintenanceSlots", fields: [offeredById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([requestId, side, startAt])
  @@index([requestId])
}

model MaintenanceAppointment {
  id              String @id @default(cuid())
  requestId       String
  request         MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  startAt         DateTime
  endAt           DateTime
  status          String  @default("CONFIRMED") // CONFIRMED, CANCELLED, DONE
  managerPresence Boolean @default(false)
  bookedById      String?
  bookedBy        User?   @relation("maintenanceAppointments", fields: [bookedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([requestId])
}

// Γενικές in-app ειδοποιήσεις (καμπανάκι + dashboard)
model Notification {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation("userNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String @default("GENERAL") // MAINTENANCE_STATUS, MAINTENANCE_COMMENT, MAINTENANCE_ASSIGNED, MAINTENANCE_APPOINTMENT, GENERAL
  title     String
  body      String? @db.Text
  href      String?
  requestId String?
  requestRef MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// CMS Content Models for public website

model CMSPage {
  id                    String   @id @default(cuid())
  slug                  String   @unique // e.g., 'home', 'privacy', 'terms'
  title                 String
  content               String   @db.Text
  metaDescription       String?
  metaKeywords          String?
  publishedAt           DateTime?
  status                String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  i18n                  Json?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model FAQ {
  id                    String   @id @default(cuid())
  question              String
  answer                String   @db.Text
  category              String   @default("general") // general, billing, features, technical
  order                 Int      @default(0)
  published             Boolean  @default(true)
  i18n                  Json?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@index([order])
}

model PricingTier {
  id                    String   @id @default(cuid())
  name                  String   // STARTER, PROFESSIONAL, ENTERPRISE
  slug                  String   @unique
  description           String?
  monthlyPrice          Float    // € per apartment per month (handoff 05 §2)
  annualPrice           Float
  features              String[] // Array of feature strings
  /// Per-building floor, per month. Null hides the "Minimum €x per building" line.
  minPerBuilding        Float?
  /// Badge over the featured card — exactly one plan on the page should carry it.
  badge                 String?
  ctaLabel              String?
  ctaHref               String?
  highlighted           Boolean  @default(false)
  order                 Int      @default(0)
  published             Boolean  @default(true)
  i18n                  Json?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([slug])
  @@index([published])
  @@index([order])
}

model ContactMessage {
  id                    String   @id @default(cuid())
  name                  String
  email                 String
  phone                 String?
  subject               String
  message               String   @db.Text
  status                String   @default("NEW") // NEW, READ, RESPONDED, SPAM
  ipAddress             String?
  userAgent             String?
  // GDPR: the exact consent wording the person ticked, and when.
  consentText           String?  @db.Text
  consentedAt           DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

enum NewsletterStatus {
  PENDING       // double opt-in email sent, not yet confirmed
  CONFIRMED
  UNSUBSCRIBED
}

// Newsletter list with a full GDPR consent trail: wording + version ticked,
// IP/UA at signup, double opt-in confirmation, one-click unsubscribe token.
model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  locale         String           @default("el")
  source         String           @default("news")   // where the form lived
  status         NewsletterStatus @default(PENDING)
  consentText    String           @db.Text
  consentVersion String           @default("v1")
  consentedAt    DateTime         @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  ipAddress      String?
  userAgent      String?
  token          String           @unique            // confirm / unsubscribe link
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

model CookieConsent {
  id                    String   @id @default(cuid())
  sessionId             String   @unique // Browser session identifier
  analytics             Boolean  @default(false)
  marketing             Boolean  @default(false)
  functional            Boolean  @default(false)
  essential             Boolean  @default(true) // Always true
  consentedAt           DateTime @default(now())
  expiresAt             DateTime // Consent valid for 12 months
  ipAddress             String?
  userAgent             String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([sessionId])
  @@index([expiresAt])
}

// App-wide brand & settings — always one row (id = "singleton")
model AppSettings {
  id              String   @id @default("singleton")

  // Client identity
  companyName     String   @default("PropertyPro")
  logoUrl         String?  // BunnyCDN — full horizontal logo (legacy fallback)
  logoSquareUrl   String?  // BunnyCDN — square/icon logo (legacy fallback)

  // Logos per theme (BunnyCDN). Full = horizontal, Square = icon-only.
  logoFullLight   String?  // full logo for light mode
  logoFullDark    String?  // full logo for dark mode
  logoSquareLight String?  // square logo for light mode
  logoSquareDark  String?  // square logo for dark mode

  // Brand colors (hex)
  colorPrimary    String   @default("#0078D4")
  colorPrimaryDk  String   @default("#005A9E")
  colorAccent     String   @default("#E31E2A")
  colorSuccess    String   @default("#107C10")
  colorWarning    String   @default("#CA5D00")
  colorDanger     String   @default("#A4262C")
  colorPurple     String   @default("#8764B8")
  colorTeal       String   @default("#038387")

  // Contact info (shown in footer / about)
  contactEmail    String?
  contactPhone    String?
  contactAddress  String?
  websiteUrl      String?

  // Provider Viva account (collects payments from app users, e.g. wallet top-ups).
  // DB-first with env fallback; secrets stored AES-256-GCM encrypted (never plaintext).
  providerVivaEnabled         Boolean @default(false)
  providerVivaClientId        String?
  providerVivaClientSecretEnc String?
  providerVivaMerchantId      String?
  providerVivaApiKeyEnc       String?
  providerVivaSourceCode      String?

  // Suppliers program (Φ2): defaults for offers → work orders
  offerMarkupPct  Decimal  @default(15) @db.Decimal(5, 2) // % added on top of the supplier price
  warrantyMonths  Int      @default(6)
  silentAcceptDays Int     @default(5) // customer confirmation deemed given after N business days

  updatedAt       DateTime @updatedAt
  updatedById     String?
}

model ImpersonationEvent {
  id            String   @id @default(cuid())
  actorId       String   // real SUPER_ADMIN user id
  targetUserId  String
  targetRole    UserRole
  action        String   // "START" | "STOP"
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
}

model LandingSection {
  id        String   @id @default(cuid())
  type      String   @unique
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

/// Structured, bilingual content for a public marketing page (pricing, news,
/// faq, contact). One row per page; `data` holds a { el, en } blob typed by
/// lib/cms/marketing-pages.ts. Long-form articles live in Article, plan rows in
/// PricingTier and questions in FAQ — this is the surrounding page furniture.
model MarketingPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageSeo {
  id        String   @id @default(cuid())
  slug      String   @unique
  seo       Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UiMessage {
  id        String   @id @default(cuid())
  key       String   @unique
  el        String   @db.Text
  en        String   @db.Text
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id           String   @id @default(cuid())
  type         String
  url          String
  cdnPath      String
  mime         String
  width        Int?
  height       Int?
  sizeBytes    Int?
  alt          String?
  title        String?
  originalName String?
  createdById  String?
  createdAt    DateTime @default(now())
  @@index([type])
  @@index([createdAt])
}

model SiteSettings {
  id                     String   @id @default("singleton")
  siteName               String   @default("PropertyPro")
  defaultOgImage         String?
  facebookUrl            String?
  instagramUrl           String?
  linkedinUrl            String?
  xUrl                   String?
  youtubeUrl             String?
  tiktokUrl              String?
  googleAnalyticsId      String?
  googleTagManagerId     String?
  facebookPixelId        String?
  extraHeadHtml          String?  @db.Text
  extraBodyHtml          String?  @db.Text
  googleSiteVerification String?
  bingSiteVerification   String?
  geoLat                 Float?
  geoLng                 Float?
  addrStreet             String?
  addrCity               String?
  addrPostal             String?
  addrCountry            String?
  telephone              String?
  openingHours           String?
  consentEnabled         Boolean  @default(true)
  consentConfig          Json?
  updatedAt              DateTime @updatedAt
  updatedById            String?
}

model Author {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  avatarMediaId String?
  bio           Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  articles      Article[]
}

model Article {
  id               String   @id @default(cuid())
  slug             String   @unique
  i18n             Json
  authorId         String?
  author           Author?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status           String   @default("DRAFT")
  publishedAt      DateTime?
  featuredMediaId  String?
  featuredEmbedUrl String?
  galleryMediaIds  Json?
  tags             String[]
  seo              Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, publishedAt])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  baseRole    UserRole
  surface     String
  isSystem    Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation("roleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  permissions RolePermission[]
  users       User[]   @relation("userRole")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([baseRole])
  @@index([surface])
}

model RolePermission {
  id        String @id @default(cuid())
  roleId    String
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleKey String
  action    String

  @@unique([roleId, moduleKey, action])
  @@index([roleId])
}

// Public "Book a demo" requests from the landing page.
model DemoRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  message     String?  @db.Text
  scheduledAt DateTime
  durationMin Int      @default(30)
  status      String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  locale      String   @default("el")
  consentText String?  @db.Text
  consentedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([scheduledAt])
  @@index([status, scheduledAt])
}

// DGsmart fluent-pm support tickets opened from the staff dashboards.
// Local record only — status lives in fluent-pm and is fetched via the public token.
model SupportTicket {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. TKT-2026-0042
  publicToken String            // status API token + /t/{token} page
  subject     String
  createdById String?
  createdBy   User?    @relation("supportTickets", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// Συνεργάτες / Προμηθευτές
//
// TWO strictly isolated registries live in this one table:
//   customerId = null → the company's (Orithon) registry. Only company staff
//                        see/manage it, and only they assign work from it.
//   customerId = X    → customer X's PRIVATE list (contact cards, no login in
//                        Φ1). Never visible to the company or other customers.
// Exactly one row has isPlatform=true: the company itself, shown by default in
// every customer's private list so they can "ask Orithon".
// ═══════════════════════════════════════════════════════════════════════════
enum SupplierKind {
  SERVICES
  PRODUCTS
  BOTH
}

model Supplier {
  id           String   @id @default(cuid())

  customerId   String?
  customer     Customer? @relation("customerSuppliers", fields: [customerId], references: [id], onDelete: Cascade)
  isPlatform   Boolean  @default(false)

  // ── SoftOne TRDR alignment (SODTYPE 12 = Προμηθευτής) ──────────────────
  sodType      Int      @default(12)
  softoneTrdr  Int?
  code         String?  // CODE — Κωδικός συναλλασσόμενου
  // ────────────────────────────────────────────────────────────────────────

  kind         SupplierKind @default(SERVICES)
  name         String   // NAME — Επωνυμία
  afm          String?  // AFM
  doy          String?  // IRSDATA
  email        String?
  phone        String?
  phone2       String?
  webpage      String?
  address      String?
  city         String?
  district     String?
  postalCode   String?
  country      String?
  isActive     Boolean  @default(true)
  remarks      String?  @db.Text

  // Contact person + payment terms
  contactName  String?
  contactPhone String?
  contactEmail String?
  iban         String?
  bank         String?
  paymentTermsDays Int?

  // Αυτοψία (site survey): χρέωση επίσκεψης εκτίμησης πριν την προσφορά, και αν
  // συμψηφίζεται όταν ανατεθεί τελικά η εργασία.
  siteSurveyFee       Decimal? @db.Decimal(10, 2)
  siteSurveyFeeWaived Boolean  @default(true)

  // Availability: { "1": [["09:00","17:00"]], ... } keyed by ISO weekday 1-7
  workingHours Json?
  emergency24h Boolean  @default(false)

  // Geodata (geocoded from the address) — proximity ranking vs. the building
  lat          Float?
  lng          Float?

  // Rating aggregates (denormalised from SupplierRating on every new rating)
  ratingAvg    Float?
  ratingCount  Int      @default(0)

  // First-login wizard (/marketplace/onboarding) completed by the supplier admin
  onboardedAt  DateTime?

  users        User[]   @relation("supplierUsers")
  ratings      SupplierRating[]
  preferredFor BuildingPreferredSupplier[]
  rfqInvitations RfqInvitation[]
  offers       SupplierOffer[]
  workOrders   WorkOrder[]
  inquiries    SupplierInquiry[]
  categories   SupplierCategory[]
  services     SupplierService[]
  products     SupplierProduct[]
  expenses     BuildingExpense[]
  recurringTasks RecurringTask[]
  contacts     Contact[]
  maintenanceRequests MaintenanceRequest[] @relation("maintenanceSupplier")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@index([isPlatform])
  @@index([afm])
  @@index([softoneTrdr])
}

// Αξιολόγηση συνεργάτη από την εταιρία μετά την ολοκλήρωση μιας εργασίας (1-5).
model SupplierRating {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  requestId  String?  @unique // one rating per fault
  request    MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  score      Int      // 1..5
  comment    String?  @db.Text
  byUserId   String?
  createdAt  DateTime @default(now())

  @@index([supplierId])
}

// Προτιμώμενος συνεργάτης ανά κτήριο (και προαιρετικά ανά κατηγορία) — συνέχεια:
// ο ίδιος συνεργάτης προτείνεται πρώτος σε συντηρήσεις/επαναλαμβανόμενες εργασίες.
model BuildingPreferredSupplier {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  categoryId String?
  category   MaintenanceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime @default(now())

  @@unique([buildingId, categoryId])
  @@index([supplierId])
}

// Ειδικότητες συνεργάτη — ποιες κατηγορίες βλαβών αναλαμβάνει.
model SupplierCategory {
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId String
  category   MaintenanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([supplierId, categoryId])
  @@index([categoryId])
}

// Master κατάλογος υπηρεσιών που «ανοίγει» η εταιρία στους συνεργάτες: στο wizard
// πρώτης σύνδεσης ο συνεργάτης επιλέγει ποιες προσφέρει (→ SupplierService rows).
model ServiceCatalogItem {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  unit        String?  // προτεινόμενη μονάδα, π.χ. "επίσκεψη"
  categoryId  String?
  category    MaintenanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  supplierServices SupplierService[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

// Κατάλογος υπηρεσιών του συνεργάτη με τιμές (net, ανά μονάδα).
// catalogItemId → επιλογή από τον master κατάλογο· null → ελεύθερη υπηρεσία.
model SupplierService {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  catalogItemId String?
  catalogItem ServiceCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  name        String
  description String?  @db.Text
  unit        String?  // π.χ. "επίσκεψη", "ώρα", "τ.μ."
  price       Decimal? @db.Decimal(10, 2)
  vatPct      Int      @default(24)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
  @@index([catalogItemId])
}

// Κατάλογος προϊόντων του συνεργάτη με τιμές (net, ανά μονάδα).
model SupplierProduct {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sku         String?
  name        String
  description String?  @db.Text
  unit        String?  // π.χ. "τεμ.", "κιβώτιο", "λίτρο"
  price       Decimal? @db.Decimal(10, 2)
  vatPct      Int      @default(24)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Συνεργάτες Φ2 — Αίτημα προσφοράς (RFQ) → Προσφορά → Σύμβαση έργου (WorkOrder)
//
// The company sends an RFQ for a fault/supply to 1..n registry suppliers; each
// answers with an offer (net price, validity, earliest date). The company picks
// ONE, adds its markup and forwards it to the customer as a WorkOrder in
// PENDING_CUSTOMER. The customer sees only the company and `customerPrice`;
// `supplierPrice` never leaves the company side. Covered jobs skip acceptance.
// ═══════════════════════════════════════════════════════════════════════════
enum RfqStatus {
  OPEN
  OFFERED
  FORWARDED
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum OfferStatus {
  SUBMITTED
  WITHDRAWN
  SELECTED
  REJECTED
}

enum WorkOrderStatus {
  PENDING_CUSTOMER
  ACCEPTED
  DECLINED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CONFIRMED
  DISPUTED
  CANCELLED
}

model ServiceRequest {
  id                   String   @id @default(cuid())
  buildingId           String
  building             Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  maintenanceRequestId String?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  categoryId           String?
  category             MaintenanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title                String
  description          String   @db.Text
  status               RfqStatus @default(OPEN)
  deadlineAt           DateTime?
  surveyRequired       Boolean  @default(false) // ask suppliers to quote a site survey
  notes                String?  @db.Text        // internal, company only

  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  invitations          RfqInvitation[]
  offers               SupplierOffer[]
  workOrders           WorkOrder[]

  @@index([buildingId])
  @@index([maintenanceRequestId])
  @@index([status])
}

model RfqInvitation {
  id            String   @id @default(cuid())
  rfqId         String
  rfq           ServiceRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status        String   @default("INVITED") // INVITED, OFFERED, DECLINED
  sentAt        DateTime @default(now())
  viewedAt      DateTime?
  declineReason String?

  @@unique([rfqId, supplierId])
  @@index([supplierId])
}

model SupplierOffer {
  id               String   @id @default(cuid())
  rfqId            String
  rfq              ServiceRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  amount           Decimal  @db.Decimal(10, 2) // net, what the supplier charges the company
  vatPct           Int      @default(24)
  surveyFee        Decimal? @db.Decimal(10, 2)
  surveyWaived     Boolean  @default(true)
  lines            Json?    // [{ name, qty, unit, unitPrice }]
  description      String?  @db.Text
  estimatedMinutes Int?
  earliestDate     DateTime?
  validUntil       DateTime?
  status           OfferStatus @default(SUBMITTED)
  submittedById    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workOrder        WorkOrder?

  @@index([rfqId])
  @@index([supplierId])
}

model WorkOrder {
  id                    String   @id @default(cuid())
  number                String   @unique // WO-2026-0042
  buildingId            String
  building              Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplierId            String
  supplier              Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  maintenanceRequestId  String?
  maintenanceRequest    MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  rfqId                 String?
  rfq                   ServiceRequest? @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  offerId               String?  @unique
  offer                 SupplierOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  title                 String
  description           String   @db.Text
  covered               Boolean  @default(false) // covered by the management contract → no customer price
  // Two prices (back-to-back): what the company pays vs. what it charges
  supplierPrice         Decimal  @db.Decimal(10, 2)
  customerPrice         Decimal  @db.Decimal(10, 2)
  vatPct                Int      @default(24)
  markupPct             Decimal? @db.Decimal(5, 2)
  surveyFee             Decimal? @db.Decimal(10, 2)
  surveyWaived          Boolean  @default(true)
  warrantyMonths        Int?

  status                WorkOrderStatus @default(PENDING_CUSTOMER)
  customerMessage       String?  @db.Text  // what the customer reads with the offer
  earliestDate          DateTime?
  validUntil            DateTime?

  // Acceptance trail (click + IP/UA/time)
  customerAcceptedAt    DateTime?
  customerAcceptedById  String?
  customerAcceptedIp    String?
  customerAcceptedUa    String?
  customerDeclinedAt    DateTime?
  customerDeclineReason String?
  supplierAcceptedAt    DateTime?
  supplierAcceptedById  String?

  scheduledAt           DateTime?

  // Proof of repair + customer confirmation (next slice)
  completedAt           DateTime?
  completionNote        String?  @db.Text
  completionMediaIds    Json?
  customerConfirmedAt   DateTime?
  customerConfirmedById String?
  // Set when the cron confirmed on the customer's behalf (silent acceptance).
  autoConfirmedAt       DateTime?
  disputeNote           String?  @db.Text

  // Frozen contract copies (rendered from ContractTemplate at acceptance time)
  customerContractHtml  String?  @db.Text
  supplierContractHtml  String?  @db.Text

  createdById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([buildingId])
  @@index([customerId])
  @@index([supplierId])
  @@index([status])
  @@index([maintenanceRequestId])
}

enum SupplierInquiryKind {
  OFFER         // "please quote"
  APPOINTMENT   // "please come on one of these dates"
}

enum SupplierInquiryStatus {
  SENT
  ANSWERED
  CLOSED
}

// A property manager's request to one of THEIR OWN private suppliers (who has
// no login): an email goes out, the manager records the answer by hand.
// Never touches the company registry / RFQ flow.
model SupplierInquiry {
  id                   String                @id @default(cuid())
  supplierId           String
  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  customerId           String
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  buildingId           String
  building             Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  maintenanceRequestId String?
  maintenanceRequest   MaintenanceRequest?   @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  kind                 SupplierInquiryKind
  status               SupplierInquiryStatus @default(SENT)
  message              String                @db.Text
  preferredDates       Json?                 // ISO strings, APPOINTMENT only
  sentTo               String                // supplier email at send time
  answer               String?               @db.Text
  answeredAt           DateTime?
  createdById          String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([customerId])
  @@index([supplierId])
  @@index([buildingId])
  @@index([maintenanceRequestId])
}

// Editable contract templates (Markdown with {{placeholders}}), one per side of
// the back-to-back work order: WO_CUSTOMER (customer ↔ company) and
// WO_SUPPLIER (company ↔ supplier). Rendered copies are frozen on the WorkOrder.
model ContractTemplate {
  id          String   @id @default(cuid())
  key         String   @unique // WO_CUSTOMER | WO_SUPPLIER
  title       String
  body        String   @db.Text
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
