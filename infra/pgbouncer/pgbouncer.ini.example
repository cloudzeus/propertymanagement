; REFERENCE ONLY — this is what the edoburu/pgbouncer entrypoint renders to
; /etc/pgbouncer/pgbouncer.ini from the variables in docker-compose.yml + .env.
; It is not mounted. Check the live file with:
;   docker exec pgbouncer cat /etc/pgbouncer/pgbouncer.ini
;
; userlist.txt (also rendered, NOT in git) contains one line:
;   "<DB_USER>" "<DB_PASSWORD>"
; plaintext is required for SCRAM between client and PgBouncer.

[databases]
propertymanagement = host=100.70.50.43 port=5432 auth_user=<DB_USER>

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432
unix_socket_dir =
user = postgres
auth_file = /etc/pgbouncer/userlist.txt
auth_type = scram-sha-256
ignore_startup_parameters = extra_float_digits

; pooling
pool_mode = transaction
max_client_conn = 500
default_pool_size = 20
min_pool_size = 2
reserve_pool_size = 5
reserve_pool_timeout = 3
max_db_connections = 40

; server connection lifecycle
server_idle_timeout = 300
server_lifetime = 3600
idle_transaction_timeout = 60

; console
admin_users = <DB_USER>
stats_users = <DB_USER>

; logging
log_connections = 0
log_disconnections = 0
log_pooler_errors = 1
log_stats = 0
