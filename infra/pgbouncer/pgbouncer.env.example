# Copy to `.env` in this folder ON THE DB VM and fill in. Never commit the copy.
# (This template is not named `.env.example` because the repo's .gitignore ignores `.env*`.)

# Upstream PostgreSQL. The container reaches the host's published :5432 through the
# Tailscale IP, so no Docker-network wiring to the postgres container is needed.
DB_HOST=100.70.50.43
DB_PORT=5432
DB_NAME=propertymanagement
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Where PgBouncer listens: the VM's Tailscale IP (same as DB_HOST today). Port is 6432.
PGBOUNCER_BIND=100.70.50.43

# ── Optional overrides (defaults in docker-compose.yml = spec §4) ───────────────
# POOL_MODE=transaction
# MAX_CLIENT_CONN=500
# DEFAULT_POOL_SIZE=20
# MIN_POOL_SIZE=2
# RESERVE_POOL_SIZE=5
# RESERVE_POOL_TIMEOUT=3
# MAX_DB_CONNECTIONS=40
# SERVER_IDLE_TIMEOUT=300
# SERVER_LIFETIME=3600
# IDLE_TRANSACTION_TIMEOUT=60
# LOG_CONNECTIONS=1
# LOG_DISCONNECTIONS=1
# LOG_STATS=1
